{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["build/**", "dist/**"], "env": ["VITE_*"] },
    "dev": { "cache": false, "persistent": true, "passThroughEnv": ["VITE_*"] },
    "test": { "outputs": [] },
    "typecheck": { "outputs": [] }
  }
}
