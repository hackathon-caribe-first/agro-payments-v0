PORT=3000
DATABASE_URL=
BETTER_AUTH_SECRET=
API_URL=
WEB_ORIGIN=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Demo only, never in production: true lets the /api routes act as the seeded producer productor@agro.dev when no one is signed in
DEMO_IDENTITY=false
# simulated (default, no network) | open-payments (Interledger testnet)
PAYMENT_GATEWAY=simulated
# Required when PAYMENT_GATEWAY=open-payments
OP_CLIENT_WALLET_ADDRESS=
OP_KEY_ID=
OP_PRIVATE_KEY_PATH=
# v3 payer of milestone grants and line payments; falls back to OP_INVESTOR_WALLET_ADDRESS when empty
OP_CUSTODY_WALLET_ADDRESS=
OP_INVESTOR_WALLET_ADDRESS=
OP_RECEIVER_WALLET_ADDRESS=
OP_ASSET_CODE=
OP_ASSET_SCALE=
# Encrypts grant tokens at rest (AES-256-GCM). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GRANT_ENCRYPTION_KEY=
